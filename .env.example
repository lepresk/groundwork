# Backend configuration shared by apps/api, apps/worker and packages/db.
# `pnpm setup` copies this file to `.env` and generates the secrets.
# Every variable is validated at boot by a Zod schema (see */src/config/env.ts).

NODE_ENV=development
LOG_LEVEL=debug

# Host ports published by docker compose (change them if they clash locally,
# and keep the URLs below in sync).
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_UI_PORT=8025

# Postgres (docker compose)
DATABASE_URL=postgres://groundwork:groundwork@localhost:5432/groundwork
DATABASE_URL_TEST=postgres://groundwork:groundwork@localhost:5432/groundwork_test

# Redis (BullMQ + rate limiting)
REDIS_URL=redis://localhost:6379
# Namespace of BullMQ keys; api (producer) and worker (consumer) must match.
QUEUE_PREFIX=groundwork

# API
API_PORT=3001
# Public URL of the web app, used to build links in emails.
WEB_PUBLIC_URL=http://localhost:3000
# Only enable when the API is reachable exclusively through the web BFF,
# which forwards the real client IP in `x-client-ip`.
TRUST_CLIENT_IP_HEADER=true

# Secrets (generated by `pnpm setup`, never commit real values)
SESSION_SECRET=
TWO_FACTOR_ENCRYPTION_KEY=

# Worker
WORKER_CONCURRENCY=5
WORKER_HEALTH_PORT=3002

# Worker: SMTP (Mailpit in development, UI on http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Groundwork <no-reply@groundwork.local>"
