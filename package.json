{
  "name": "groundwork",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade NestJS + Next.js monorepo starter: strict TypeScript, BFF, session auth with 2FA, BullMQ worker, and first-class AI agent rules.",
  "license": "MIT",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "setup": "node scripts/setup.mjs",
    "rename": "node scripts/rename.mjs",
    "gen": "node scripts/gen/index.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "test:coverage": "turbo run test:coverage --concurrency=1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:text": "node scripts/check-text.mjs",
    "check:deps": "sherif",
    "check:unused": "knip",
    "check": "pnpm format:check && pnpm check:text && pnpm check:docs && pnpm check:deps && pnpm lint && pnpm typecheck && pnpm check:unused",
    "verify": "pnpm check && pnpm build && pnpm test",
    "db:generate": "pnpm --filter @groundwork/db db:generate",
    "db:migrate": "pnpm --filter @groundwork/db db:migrate",
    "db:studio": "pnpm --filter @groundwork/db db:studio",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,jsx,json,md,mdc,yml,yaml,css}": "prettier --write",
    "*.{ts,tsx,js,mjs,md,mdc}": "node scripts/check-text.mjs",
    "*.{ts,tsx,js,mjs,cjs}": "node scripts/check-docs.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "sherif": "^1.13.0",
    "turbo": "^2.11.0",
    "typescript": "catalog:"
  }
}
