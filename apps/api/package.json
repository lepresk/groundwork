{
  "name": "@groundwork/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "HTTP API (NestJS). Owns business rules, persistence, and authentication.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths",
    "dev": "node --watch --enable-source-maps --import @swc-node/register/esm-register src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@groundwork/db": "workspace:*",
    "@groundwork/shared": "workspace:*",
    "@lepresk/after-commit": "^0.1.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/swagger": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@nestjs/throttler": "catalog:",
    "argon2": "^0.45.1",
    "bullmq": "catalog:",
    "drizzle-orm": "catalog:",
    "ioredis": "^5.8.0",
    "iron-session": "^8.0.4",
    "nestjs-pino": "catalog:",
    "nestjs-zod": "catalog:",
    "otplib": "^13.5.0",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@groundwork/eslint-config": "workspace:*",
    "@groundwork/tsconfig": "workspace:*",
    "@nestjs/testing": "catalog:",
    "@swc-node/register": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@types/express": "^5.0.3",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "pino-pretty": "catalog:",
    "supertest": "^7.3.0",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vitest": "catalog:"
  }
}
