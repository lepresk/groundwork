{
  "name": "@groundwork/api",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "HTTP API (NestJS). Owns business rules, persistence, and authentication.",
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && swc src -d dist --strip-leading-paths",
    "dev": "node --watch --enable-source-maps --import @swc-node/register/esm-register src/main.ts",
    "start": "node --enable-source-maps dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist .turbo coverage"
  },
  "dependencies": {
    "@groundwork/db": "workspace:*",
    "@groundwork/shared": "workspace:*",
    "@lepresk/after-commit": "^0.1.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.7.1",
    "argon2": "^0.45.1",
    "bullmq": "^5.60.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.8.0",
    "iron-session": "^8.0.4",
    "nestjs-pino": "^5.0.0",
    "nestjs-zod": "^5.5.0",
    "otplib": "^13.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@groundwork/eslint-config": "workspace:*",
    "@groundwork/tsconfig": "workspace:*",
    "@nestjs/testing": "^11.1.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.7.0",
    "@swc/core": "^1.16.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.3.0",
    "typescript": "~6.0.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.0"
  }
}
