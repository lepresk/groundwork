{
  "name": "@groundwork/web",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Web app (Next.js App Router). Acts as a BFF: the browser only talks to this server.",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3000",
    "start": "next start --port 3000",
    "lint": "next typegen && eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf .next .turbo coverage"
  },
  "dependencies": {
    "@groundwork/shared": "workspace:*",
    "@groundwork/ui": "workspace:*",
    "@hookform/resolvers": "^5.2.0",
    "@lepresk/next-bff-fetch": "^0.1.0",
    "next": "catalog:",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "^7.62.0",
    "server-only": "^0.0.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@groundwork/eslint-config": "workspace:*",
    "@groundwork/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.1.0",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.5",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "^4.1.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
